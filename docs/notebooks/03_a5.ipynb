   "source": [
    "from vgrid.binning.a5bin import a5bin\n",
    "file_path = (\n",
    "    \"https://raw.githubusercontent.com/opengeoshub/vopendata/main/csv/housing.csv\"\n",
    ")\n",
    "stats = \"max\"\n",
    "numeric_col=\"median_house_value\"\n",
    "\n",
    "options = {\"segments\": 'auto'}\n",
    "\n",
    "a5_bin = a5bin(file_path, \n",
    "                resolution=8, \n",
    "                stats=stats, \n",
    "                numeric_col=numeric_col,\n",
    "                # category_col=\"category\",\n",
    "                output_format=\"gpd\",\n",
    "                options=options)\n",
    "\n",
    "a5_bin.plot(\n",
    "    column= f\"{numeric_col}_{stats}\",        # numeric column to base the colors on\n",
    "    cmap='Spectral_r',        # color scheme (matplotlib colormap)\n",
    "    legend=True,  \n",
    "    linewidth=0.2          # boundary width (optional)\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "557f7f91",
   "metadata": {},
   "source": [
    "### A5 Resampling"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "7ecf68c0",
   "metadata": {
    "vscode": {
     "languageId": "shellscript"
    }
   },
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "Generating H3 DGGS: 100%|██████████| 3693/3693 [00:00<00:00, 57871.81it/s]\n",
      "Nearest neighbor resampling: 100%|██████████| 1562/1562 [00:00<00:00, 31586.45 cells/s]\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "<Axes: >"
      ]
     },
     "execution_count": 13,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "from vgrid.conversion.dggsresample import dggsresample\n",
    "a5_resample = dggsresample(\n",
    "    source_dggs=a5_bin,\n",
    "    dggs_from=\"a5\",\n",
    "    dggs_to=\"h3\",\n",
    "    method = \"nearest\", # area_weighted, nearest\n",
    "    predicate=\"centroid_within\",  # centroid_within, intersects\n",
    "    dggs_col=\"a5\",\n",
    "    resample_col=f\"{numeric_col}_{stats}\",  # column on h3_bin with numbers\n",
    "    fix_antimeridian=None,\n",
    "    split_antimeridian=False,\n",
    ")\n",
    "a5_resample.plot(\n",
    "    column=f\"{numeric_col}_{stats}\",  # numeric column to base the colors on\n",
    "    cmap=\"Spectral_r\",  # color scheme (matplotlib colormap)\n",
    "    legend=True,\n",
    "    linewidth=0.2,  # boundary width (optional)\n",
    ")"
   ]
  },
