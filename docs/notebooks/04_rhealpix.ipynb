    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "from vgrid.binning.rhealpixbin import rhealpixbin\n",
    "\n",
    "file_path = (\n",
    "    \"https://raw.githubusercontent.com/opengeoshub/vopendata/main/csv/housing.csv\"\n",
    ")\n",
    "stats = \"max\"\n",
    "numeric_col = \"median_house_value\"\n",
    "\n",
    "rhealpix_bin = rhealpixbin(\n",
    "    file_path,\n",
    "    resolution=6,\n",
    "    stats=stats,\n",
    "    numeric_col=numeric_col,\n",
    "    # category_col=\"category\",\n",
    "    output_format=\"gpd\",\n",
    ")\n",
    "rhealpix_bin.plot(\n",
    "    column=f\"{numeric_col}_{stats}\",  # numeric column to base the colors on\n",
    "    cmap=\"Spectral_r\",  # color scheme (matplotlib colormap)\n",
    "    legend=True,\n",
    "    linewidth=0.2,  # boundary width (optional)\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cfe5f9e1",
   "metadata": {},
   "source": [
    "### rHEALPix Resampling"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "0f0f2457",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "Generating A5 cells: 100%|██████████| 7598/7598 [00:00<00:00, 9811.74 cells/s] \n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "<Axes: >"
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "from vgrid.conversion.dggsresample import dggsresample\n",
    "\n",
    "rhealpix_resample = dggsresample(\n",
    "    source_dggs=rhealpix_bin,\n",
    "    dggs_from=\"rhealpix\",\n",
    "    dggs_to=\"a5\",\n",
    "    method=\"nearest\",  # area_weighted, nearest\n",
    "    predicate=\"centroid_within\",  # centroid_within, intersects\n",
    "    dggs_col=\"rhealpix\",\n",
    "    resample_col=f\"{numeric_col}_{stats}\",  # column on h3_bin with numbers\n",
    "    fix_antimeridian=None,\n",
    "    split_antimeridian=False,\n",
    ")\n",
    "rhealpix_resample.plot(\n",
    "    column=f\"{numeric_col}_{stats}\",  # numeric column to base the colors on\n",
    "    cmap=\"Spectral_r\",  # color scheme (matplotlib colormap)\n",
    "    legend=True,\n",
    "    linewidth=0.2,  # boundary width (optional)\n",
    ")"
   ]
  },
