   "source": [
    "### rHEALPix Binning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "e0acafe5",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "Generating rHEALPix DGGS: 100%|██████████| 5976/5976 [00:00<00:00, 9934.85 cells/s] \n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "<Axes: >"
      ]
     },
     "execution_count": 1,
     "metadata": {},
